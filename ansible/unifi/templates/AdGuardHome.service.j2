# Managed by ansible
[Unit]
Description=AdGuard Home: Network-level blocker
ConditionFileIsExecutable={{ adguard_dir }}/AdGuardHome
After=network-online.target

[Service]
StartLimitInterval=5
StartLimitBurst=10
# Updates come from the playbook's pinned adguard_version (Renovate), not the built-in updater
ExecStart={{ adguard_dir }}/AdGuardHome -s run --no-check-update
WorkingDirectory={{ adguard_dir }}
Restart=always
RestartSec=10
EnvironmentFile=-/etc/sysconfig/AdGuardHome

[Install]
WantedBy=multi-user.target
