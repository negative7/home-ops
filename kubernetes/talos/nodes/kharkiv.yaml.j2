---
machine:
  type: controlplane
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.model == "CT1000MX500SSD1"
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node.kubernetes.io/gpu: "true"
  storage.miroir.home-operations.com/class: default
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: kharkiv
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: miroir-data
provisioning:
  diskSelector:
    match: disk.model == "KXG60ZNV512G KIOXIA"
  maxSize: 476GiB
