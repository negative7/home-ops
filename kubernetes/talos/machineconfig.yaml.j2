---
# yaml-language-server: $schema=https://raw.githubusercontent.com/siderolabs/talos/refs/heads/release-1.14/website/content/v1.14/schemas/config.schema.json
version: v1alpha1
machine:
  ca:
    crt: op://home-cluster/home-ops/MACHINE_CA_CRT
    {% if ENV.IS_CONTROLPLANE %}
    key: op://home-cluster/home-ops/MACHINE_CA_KEY
    {% endif %}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    rbac: true
  logging:
    destinations:
      - endpoint: tcp://127.0.0.1:13333/
        format: json_lines
  token: op://home-cluster/home-ops/MACHINE_TOKEN
cluster:
  {% if ENV.IS_CONTROLPLANE %}
  aggregatorCA:
    crt: op://home-cluster/home-ops/CLUSTER_AGGREGATORCA_CRT
    key: op://home-cluster/home-ops/CLUSTER_AGGREGATORCA_KEY
  etcd:
    advertisedSubnets:
      - 10.2.0.0/24
    ca:
      crt: op://home-cluster/home-ops/CLUSTER_ETCD_CA_CRT
      key: op://home-cluster/home-ops/CLUSTER_ETCD_CA_KEY
    extraArgs:
      auto-compaction-mode: revision
      auto-compaction-retention: "10000"
      election-timeout: "5000"
      heartbeat-interval: "500"
      listen-metrics-urls: http://0.0.0.0:2381
      snapshot-count: "5000"
  serviceAccount:
    key: op://home-cluster/home-ops/CLUSTER_SERVICEACCOUNT_KEY
  {% endif %}
  ca:
    crt: op://home-cluster/home-ops/CLUSTER_CA_CRT
    {% if ENV.IS_CONTROLPLANE %}
    key: op://home-cluster/home-ops/CLUSTER_CA_KEY
    {% endif %}
  controlPlane:
    endpoint: https://k8s.homelab.internal:6443
  clusterName: home-ops
  token: op://home-cluster/home-ops/CLUSTER_TOKEN
---
apiVersion: v1alpha1
kind: KmsgLogConfig
name: victoria-logs
url: tcp://127.0.0.1:13333/
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/c0986b75e6403ad8ca29191038bc6628931d35cbb24eb0e4220dfdf6c141f5ad:v1.14.5
provisioning:
  wipe: false
---
apiVersion: v1alpha1
kind: LinkConfig
name: eno1
mtu: 9000
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: eno1
clientIdentifier: none # legacy .machine.network.interfaces DHCP sent no client identifier
---
# IOT
apiVersion: v1alpha1
kind: VLANConfig
name: eno1.4
vlanID: 4
parent: eno1
mtu: 1500
---
# VPN
apiVersion: v1alpha1
kind: VLANConfig
name: eno1.770
vlanID: 770
parent: eno1
mtu: 1500
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.2.0.20
link: eno1
---
apiVersion: v1alpha1
kind: StaticHostConfig
name: 10.2.0.20
hostnames:
  - k8s.homelab.internal
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
  disableDefault: true
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: op://home-cluster/home-ops/CLUSTER_ID
clusterSecret: op://home-cluster/home-ops/CLUSTER_SECRET
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_thin_pool # miroir lvmthin backend
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: drbd # miroir replication
parameters:
  - usermode_helper=disabled # required on Talos (no /sbin/drbdadm)
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: drbd_transport_tcp
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.ping_group_range: 0 2147483647
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_notsent_lowat: "131072"
  net.ipv4.tcp_rmem: 4096 87380 33554432
  net.ipv4.tcp_slow_start_after_idle: "0"
  net.ipv4.tcp_window_scaling: "1"
  net.ipv4.tcp_wmem: 4096 65536 33554432
  sunrpc.tcp_max_slot_table_entries: "128"
  sunrpc.tcp_slot_table_entries: "128"
  user.max_user_namespaces: "11255"
  vm.nr_hugepages: "0"
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfs.conf
mode: 0o644
contents: |
  [nfsrahead]
  nfs4=16384
  default=128
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  nconnect=8
  noatime=True
  rsize=1048576
  wsize=1048576
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: 20-customization
content: |
  [plugins]
    [plugins."io.containerd.grpc.v1.cri"]
      enable_unprivileged_ports = true
      enable_unprivileged_icmp = true
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
# Zot pull-through cache on lviv (docker/lviv/05-zot); containerd falls back to upstream when it is down
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: docker.io
endpoints:
  - url: http://lviv.homelab.internal:5000/v2/docker-hub/
    overridePath: true
---
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: ghcr.io
endpoints:
  - url: http://lviv.homelab.internal:5000/v2/ghcr/
    overridePath: true
---
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: quay.io
endpoints:
  - url: http://lviv.homelab.internal:5000/v2/quay/
    overridePath: true
---
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: registry.k8s.io
endpoints:
  - url: http://lviv.homelab.internal:5000/v2/k8s/
    overridePath: true
---
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: mirror.gcr.io
endpoints:
  - url: http://lviv.homelab.internal:5000/v2/gcr/
    overridePath: true
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 10.2.0.0/24
{% if ENV.IS_CONTROLPLANE %}
# KubeNodeConfig does not add the control-plane role label the way .machine.nodeLabels did,
# and without .cluster.allowSchedulingOnControlPlanes no NoSchedule taint is added either
labels:
  node-role.kubernetes.io/control-plane: ""
{% endif %}
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  maxPods: 150
  serializeImagePulls: false
  shutdownGracePeriod: 120s # mandatory for miroir/DRBD to release cleanly on reboot
  shutdownGracePeriodCriticalPods: 60s
defaultRuntimeSeccompProfileEnabled: true
image: ghcr.io/siderolabs/kubelet:v1.37.1
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.244.0.0/16
serviceSubnets:
  - 10.96.0.0/12
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
{% if ENV.IS_CONTROLPLANE %}
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
certExtraSANs:
  - k8s.homelab.internal
  - 10.2.0.20
  - 127.0.0.1 # KubePrism
extraArgs:
  enable-aggregator-routing: "true"
  feature-gates: HPAScaleToZero=true
  runtime-config: admissionregistration.k8s.io/v1beta1=true
image: registry.k8s.io/kube-apiserver:v1.37.1
---
# KubeAPIServerConfig does not inject the default Node/RBAC authorizers like .cluster.apiServer did
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
    enabled: true
  jwt: []
---
# key3 replaced the leaked key2 on 2026-10-21; identity stays as a read fallback
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - providers:
        - secretbox:
            keys:
              - name: key3
                secret: op://home-cluster/home-ops/CLUSTER_SECRETBOX_KEY3
        - identity: {}
      resources:
        - secrets
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: 0.0.0.0
  feature-gates: HPAScaleToZero=true
image: registry.k8s.io/kube-controller-manager:v1.37.1
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.37.1
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
extraArgs:
  bind-address: 0.0.0.0
image: registry.k8s.io/kube-scheduler:v1.37.1
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - system-upgrade
{% endif %}
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 300GiB
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: miroir-sda
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 620GiB
