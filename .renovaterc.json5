{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#7.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#7.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#7.0.0",
    "local>negative7/home-ops//.renovate/autoMerge.json5",
    "local>negative7/home-ops//.renovate/changelogs.json5",
    "local>negative7/home-ops//.renovate/customManagers.json5",
    "local>negative7/home-ops//.renovate/grafanaDashboards.json5",
    "local>negative7/home-ops//.renovate/groups.json5",
    "local>negative7/home-ops//.renovate/labels.json5",
    "local>negative7/home-ops//.renovate/semanticCommits.json5",
    ":semanticCommits",
    ":timezone(America/New_York)",
  ],
  // Forgejo/Gitea bug: commits/{ref}/statuses 404s when the ref contains a
  // URL-encoded slash, which breaks resolveBranchStatus for the default
  // "renovate/" prefix. See https://github.com/go-gitea/gitea/issues/36253
  branchPrefix: "renovate-",
  commitBodyTable: true,
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
}
