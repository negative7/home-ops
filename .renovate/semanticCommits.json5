{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Scopes and the major "!" prefix come from the home-operations default preset. These keep this
  // repo's style on top: feat/fix by update type for every manager (upstream makes mise, github-release
  // and renovate-config updates chore), a bare depName topic and spaced version brackets
  packageRules: [
    {
      matchUpdateTypes: ["major", "minor"],
      semanticCommitType: "feat",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "fix",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentDigestShort}} ➔ {{newDigestShort}} )",
    },
    {
      // Comes after the type rules above so workflow updates stay ci(github-action)
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
    },
  ],
}
