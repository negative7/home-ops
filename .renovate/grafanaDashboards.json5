{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The grafanaDashboards preset itself is extended from .renovaterc.json5, where the
  // renovate-config manager keeps its version in step with the other presets
  packageRules: [
    {
      addLabels: ["renovate/grafana-dashboard"],
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
    },
  ],
}
