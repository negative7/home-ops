{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // A Postgres major needs a planned upgrade (and matching extension images), never a tag bump.
      // Minor/patch bumps (18.6 -> 18.7) flow normally; docker versioning keeps the -standard-trixie suffix pinned.
      description: "Never bump the CloudNativePG operand across a major version",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
