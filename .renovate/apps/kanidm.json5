{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // kaniop blocks any Kanidm image newer than the SDK it was built with (1.12.0 was refused by kaniop 0.21.0,
      // 2026-11-05). Lift this once a kaniop release supports the new version.
      description: "Hold Kanidm server minor/major bumps until kaniop supports them",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kanidm/server"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
  ],
}
