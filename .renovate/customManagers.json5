{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process raw GitHub URLs",
      fileMatch: ["/\\.env$/", "/\\.sh$/", "/\\.ya?ml(\\.j2)?$/"],
      matchStrings: [
        // https://raw.githubusercontent.com/external-secrets/external-secrets/v0.9.11/docs/snippets/dashboard.json
        "https:\\/\\/raw.githubusercontent.com\\/(?<depName>\\S+?\\/\\S+?)\\/(?<currentValue>(v|\\d)\\S+?)\\/\\S+",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process GitHub release download URLs",
      managerFilePatterns: [
        "/^kubernetes/.+\\.yaml(?:\\.j2)?$/"
      ],
      matchStrings: [
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/releases/download/(?<currentValue>[^/\\s]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process @actual-app/api version pinned in the Actual bank-sync CronJob's runtime npm install",
      managerFilePatterns: [
        "/^kubernetes\\/apps\\/selfhosted\\/actual\\/.+\\.ya?ml$/"
      ],
      matchStrings: [
        "npm install[^\\n]*(?<depName>@actual-app/api)@(?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      description: "Track 1Password CLI via the official 1password/op Docker image, since the CLI itself is closed-source with no GitHub releases",
      managerFilePatterns: ["/^\\.mise\\.toml$/"],
      matchStrings: [
        "\"1password-cli\"\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
      depNameTemplate: "1password/op",
      datasourceTemplate: "docker",
      extractVersionTemplate: "^(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
  ],
}
