{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets//managers/annotated.json5#4.0.0",
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Process raw GitHub URLs",
      fileMatch: ["/\\.env$/", "/\\.sh$/", "/\\.ya?ml(\\.j2)?$/"],
      matchStrings: [
        // https://raw.githubusercontent.com/external-secrets/external-secrets/v0.9.11/docs/snippets/dashboard.json
        "https:\\/\\/raw.githubusercontent.com\\/(?<depName>\\S+?\\/\\S+?)\\/(?<currentValue>(v|\\d)\\S+?)\\/\\S+",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: [
        "/^kubernetes/.+\\.yaml(?:\\.j2)?$/"
      ],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process CloudNativePG Cluster imageName",
      managerFilePatterns: [
        "/^kubernetes/.+\\.yaml(?:\\.j2)?$/"
      ],
      matchStrings: [
        "imageName:\\s+(?<depName>[^:\\s]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process Talos machine config image references",
      managerFilePatterns: [
        "/^kubernetes\\/talos\\/.+\\.ya?ml(?:\\.j2)?$/"
      ],
      matchStrings: [
        "image:\\s+(?<depName>[^:\\s]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process GitHub release download URLs",
      managerFilePatterns: [
        "/^kubernetes/.+\\.yaml(?:\\.j2)?$/"
      ],
      matchStrings: [
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/releases/download/(?<currentValue>[^/\\s]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process @actual-app/api version pinned in the Actual bank-sync CronJob's runtime npm install",
      managerFilePatterns: [
        "/^kubernetes\\/apps\\/selfhosted\\/actual\\/.+\\.ya?ml$/"
      ],
      matchStrings: [
        "npm install[^\\n]*(?<depName>@actual-app/api)@(?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "npm",
    },
  ],
}
