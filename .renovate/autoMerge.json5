{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Same tag, new digest (rebuild) or first-time pin: the version doesn't change.
      // Floating tags are excluded because a new digest there means new code.
      description: "Auto-merge digest pins and rebuilds of versioned tags",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["pinDigest", "digest"],
      matchCurrentValue: "!/^(main|master|latest|release|rolling|edge|nightly)$/",
      automerge: true,
      automergeType: "pr",
    },
    {
      // A new digest behind an existing tag is a re-push; give a bad or compromised one a day to be pulled
      description: "Soak digest rebuilds for a day",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      minimumReleaseAge: "1 day",
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      // Patch releases of apps and charts, after a 3-day soak so regressions surface upstream first.
      // Core infrastructure is excluded and always gets a manual review.
      description: "Auto-merge patch updates outside core infrastructure",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch"],
      // Negation-only list: matches every package except these
      matchPackageNames: [
        "!/forgejo/",
        "!/cilium/",
        "!/coredns/",
        "!/cloudnative-pg/",
        "!/postgres/",
        "!/kanidm|kaniop/",
        "!/miroir/",
        "!/kopi/",
        "!/flux/",
        "!/siderolabs/",
        "!/kube-apiserver|kube-controller-manager|kube-scheduler|kubelet/",
        "!/envoy/",
        "!/spegel/",
        "!/multus/",
        "!/cert-manager|trust-manager/",
        "!/external-secrets/",
        "!/1password/",
        "!/tuppr/",
      ],
      minimumReleaseAge: "3 days",
      // Some registries return no release timestamp; don't hold those updates forever
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge high-cadence packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest", "minor", "patch"],
      matchPackageNames: [
        "ghcr.io/renovatebot/renovate",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/emberstack/helm-charts/reflector",
        "ghcr.io/mogenius/helm-charts/renovate-operator",
        "ghcr.io/nesquena/hermes-webui",
        "ghcr.io/jdx/mise",
        "ghcr.io/home-operations/charts/kritika",
        "ghcr.io/atuinsh/atuin",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/prowlarr",
      ],
      automerge: true,
      automergeType: "pr",
      schedule: ["before 6am on Monday"],
    },
    {
      // MCP servers are tooling for agents, not core services; 0.x minors count as major, so include every type
      description: "Auto-merge all MCP server updates straight to main",
      matchDatasources: ["docker"],
      matchPackageNames: ["/mcp/"],
      matchUpdateTypes: ["major", "minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
    },
    {
      // Dev and CI tooling, any update type including 0.x minors and majors; a bad bump is a one-line revert
      description: "Auto-merge all dev tooling (mise) updates",
      matchManagers: ["mise"],
      matchUpdateTypes: ["major", "minor", "patch"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
  ],
}
