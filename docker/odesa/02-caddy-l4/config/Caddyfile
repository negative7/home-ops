{
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443

	# Only hosts served by odesa itself are routed for now. Public ingress to home
	# (WireGuard tunnel to envoy-external) is added later as a fallback route per port.
	layer4 {
		:443 {
			matching_timeout 15s
			@local tls sni {$VPS_LOCAL_HOSTS}
			route @local {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8443
				}
			}
		}
		:80 {
			@local_http http host {$VPS_LOCAL_HOSTS}
			route @local_http {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8080
				}
			}
		}
	}

	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
	}
	servers :8080 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
		}
	}

	log default {
		output stdout
		format json
	}
}

odesa-doco-cd.negative7.com {
	reverse_proxy doco-cd:8880
}

odesa-gatus.negative7.com {
	reverse_proxy gatus:8080
}
