{
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443

	# Hosts served by odesa itself match first; every other negative7.com host is
	# passed through (TLS untouched) over WireGuard to envoy-external at home.
	layer4 {
		:443 {
			matching_timeout 15s
			@local tls sni {$VPS_LOCAL_HOSTS}
			route @local {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8443
				}
			}
			@home tls sni negative7.com *.negative7.com
			route @home {
				proxy {
					proxy_protocol v2
					upstream {$HOME_EDGE_UPSTREAM}:443
				}
			}
		}
		:80 {
			@local_http http host {$VPS_LOCAL_HOSTS}
			route @local_http {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8080
				}
			}
			@home_http http host negative7.com *.negative7.com
			route @home_http {
				proxy {
					proxy_protocol v2
					upstream {$HOME_EDGE_UPSTREAM}:80
				}
			}
		}
	}

	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
	}
	servers :8080 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
		}
	}

	metrics

	log default {
		output stdout
		format json
	}
}

odesa-doco-cd.negative7.com {
	# Only the push webhook and the health check; the /v1/api/* management API stays private
	@public {
		path /v1/webhook /v1/webhook/* /v1/health
	}
	handle @public {
		reverse_proxy doco-cd:8880
	}
	handle {
		respond 404
	}
}

odesa-gatus.negative7.com {
	reverse_proxy gatus:8080
}

# Prometheus metrics, proxied to home by 04-exporters
http://:9180 {
	metrics
}
